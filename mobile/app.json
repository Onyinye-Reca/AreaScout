{
  "expo": {
    "name": "AreaScout",
    "slug": "areascout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.areascout.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1A36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.areascout.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "AreaScout needs your photos so you can add pictures to your listings."
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "areascout",
    "backgroundColor": "#F3F4F6"
  }
}
