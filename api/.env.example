NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# ---- Database -------------------------------------------------------------
# Local default: SQLite, no setup.
DB_TYPE=sqlite
DB_PATH=data/areascout.sqlite3
# Hosted / production: Postgres. Either one connection string...
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true                  # most hosted Postgres requires an encrypted connection
# DB_SSL_CA=                   # provider's certificate authority (PEM or base64), e.g. Supabase's downloadable certificate
# DB_SSL_REJECT_UNAUTHORIZED=false   # stop-gap only: encrypted but unverified
# ...or separate values:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=areascout
# DB_SCHEMA=public
# DB_MIGRATIONS_RUN=true       # apply pending migrations on start (default true)

# ---- Photos ---------------------------------------------------------------
STORAGE_DRIVER=local           # local = this server's disk; s3 = S3-compatible storage
UPLOAD_DIR=data/uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=areascout-photos
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # leave out for AWS S3
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev                    # where the bucket's files are publicly served

# ---- Web ------------------------------------------------------------------
# Website address(es) allowed by CORS, comma separated. Use "*" only locally.
CORS_ORIGIN=*
SWAGGER_ENABLED=true           # API docs at /docs (always off in production unless set)
# Set true behind a reverse proxy / hosting platform so rate limits count each visitor separately.
TRUST_PROXY=false
RATE_LIMIT=true

# ---- Accounts and data ----------------------------------------------------
# Creates this admin on start if the email isn't registered yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Sample listings and a demo landlord. Set false for anything real users will see.
SEED_DEMO_DATA=true
