# Environment variables for the AreaScout API on Render (staging).
#
# How to use: in Render, open the service -> Environment -> "Add from .env" (or add them one by one),
# and fill in every value that says <...>. Do NOT put real secrets in this file or commit them;
# this file is only a checklist. Render stores the values privately.
#
# Render service settings (not environment variables):
#   Root Directory : api
#   Build Command  : npm ci && npm run build
#   Start Command  : npm run start:prod
#   Health Check   : /health
#   Region         : Frankfurt (closest to a Europe-hosted Supabase database)

# ---- Runtime ----------------------------------------------------------------
NODE_VERSION=20
NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false
RATE_LIMIT=true
# Render sits behind a proxy; without this every visitor shares one rate limit.
TRUST_PROXY=true

# ---- Database (Supabase) ----------------------------------------------------
DB_TYPE=postgres
# Supabase -> Connect -> "Session pooler" string, with your real password replacing [YOUR-PASSWORD].
DATABASE_URL=<paste the session pooler connection string, with the password filled in>
DB_SSL=true
DB_MIGRATIONS_RUN=true
# Supabase's connection uses its own certificate authority, which Node doesn't know, so without one of
# the two lines below the API fails with "self-signed certificate in certificate chain".
#
# Recommended: Supabase -> Project Settings -> Database -> SSL Configuration -> "Download certificate".
# Then on your Mac:  base64 -i ~/Downloads/<that file>.crt | tr -d '\n' | pbcopy   and paste the result here.
DB_SSL_CA=<base64 of the certificate you downloaded from Supabase>
# Stop-gap for a first test (still encrypted, but doesn't check who it is talking to). Remove once DB_SSL_CA works:
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Photos (Supabase Storage, S3 compatible) --------------------------------
# Supabase -> Storage -> create a PUBLIC bucket named areascout-photos,
# then Storage -> S3 Connection: copy the endpoint and region it shows and create an access key.
STORAGE_DRIVER=s3
S3_BUCKET=areascout-photos
# These two follow Supabase's usual pattern; confirm them against the S3 Connection page.
S3_ENDPOINT=https://wjqgaeyhercabjnqebyw.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://wjqgaeyhercabjnqebyw.supabase.co/storage/v1/object/public/areascout-photos
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=<from Supabase S3 Connection>
S3_SECRET_ACCESS_KEY=<from Supabase S3 Connection>

# ---- Website address allowed to call the API ---------------------------------
# Fill in after the website is on Netlify, e.g. https://areascout.netlify.app (no trailing slash).
CORS_ORIGIN=<your Netlify website address>

# ---- First admin account ------------------------------------------------------
# Created on first start if this email isn't registered. Use a long, unique password from a password manager.
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<long unique password>

# ---- Sample data --------------------------------------------------------------
# true = three demo Lagos listings for staging. Set false once real listings exist.
SEED_DEMO_DATA=true
